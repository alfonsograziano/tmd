{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engine",
  "description": "An engine, so two cars can share one record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "layout"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "The engine name." },
    "layout": { "enum": ["inline-4", "inline-6", "v6", "v8", "rotary", "electric"], "description": "How the cylinders sit." },
    "displacement_cc": { "type": "integer", "minimum": 0, "description": "Displacement in cubic centimetres." },
    "designer": { "type": "string", "format": "tmd-ref", "x-tmd-ref": "person", "description": "Who designed it." },
    "created": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "x-tmd": { "plural": "engines" }
}
